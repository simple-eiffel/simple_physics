<?xml version="1.0" encoding="ISO-8859-1"?>
<system name="simple_physics" uuid="12345678-1234-5678-1234-567812345678">
	<target name="simple_physics">
		<description>Physics simulation engine with RK4 integration and collision detection</description>
		<root class="SIMPLE_PHYSICS" feature="make"/>
		<option warning="true" void_safety="all">
			<assertions precondition="true" postcondition="true" invariant="true" check="true"/>
			<concurrency support="scoop"/>
		</option>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<library name="testing" location="$ISE_LIBRARY/library/testing/testing.ecf"/>
		<library name="simple_math" location="d:\prod\simple_math\simple_math.ecf"/>
		<library name="simple_mml" location="d:\prod\simple_mml\simple_mml.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
	</target>
	<target name="simple_physics_tests">
		<description>Test suite for physics engine</description>
		<root class="TEST_APP" feature="make"/>
		<option warning="true" void_safety="all">
			<assertions precondition="true" postcondition="true" invariant="true" check="true"/>
			<concurrency support="scoop"/>
		</option>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<library name="testing" location="$ISE_LIBRARY/library/testing/testing.ecf"/>
		<library name="simple_math" location="d:\prod\simple_math\simple_math.ecf"/>
		<library name="simple_mml" location="d:\prod\simple_mml\simple_mml.ecf"/>
		<library name="simple_testing" location="d:\prod\simple_testing\simple_testing.ecf"/>
		<cluster name="src" location=".\src\" recursive="true"/>
		<cluster name="test" location=".\test\" recursive="true"/>
	</target>
</system>
